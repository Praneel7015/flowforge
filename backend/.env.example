# ─────────────────────────────────────────────────────────────
# FlowForge Configuration
# Platform-independent CI/CD automation with multi-AI support
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# DEFAULT PROVIDERS
# Used when not specified in API request
# ─────────────────────────────────────────────────────────────
DEFAULT_AI_PROVIDER=groq
# Options: groq, anthropic, gemini, openai, ollama

DEFAULT_CICD_PLATFORM=gitlab
# Options: gitlab, github, jenkins, circleci, bitbucket

# ─────────────────────────────────────────────────────────────
# AI PROVIDERS
# Configure at least one AI provider to enable AI features
# ─────────────────────────────────────────────────────────────

# Groq (Fast Free Tier — Recommended Default)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b (llama-3.3-70b-versatile was shut down 2026-08-16)

# Anthropic (Claude)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5-5
# Models: claude-sonnet-5-5, claude-opus-5-5, claude-haiku-5-5

# Google Gemini
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
# Models: gemini-3.8-flash, gemini-3.5-flash-lite (1.5 / 2.0 models are shut down)

# OpenAI
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-6-luna
# Models: gpt-6-luna, gpt-5.6-sol (gpt-4-turbo was shut down 2026-10-23)

# Google Vertex AI (optional server-side default; users can bring their own)
# Either an express-mode API key, or a service account JSON key (one line).
VERTEX_API_KEY=
VERTEX_SERVICE_ACCOUNT_JSON=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash

# AWS Bedrock (optional server-side default; users can bring their own)
# Either a Bedrock API key, or IAM access keys with bedrock:InvokeModel.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_SESSION_TOKEN=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6

# Any OpenAI-compatible endpoint (OpenRouter, Together, DeepSeek, ...)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# Ollama (Local LLM - no API key required)
# Install Ollama: https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Models: llama3, mistral, codellama, or any model you have installed

# n8n Webhook (Hackathon sponsor integration)
# If set, pipeline chat requests are sent to this webhook.
# Example: https://your-n8n-domain/webhook-test/flowforge
N8N_CHAT_WEBHOOK_URL=
# Optional custom auth header + token for securing the webhook.
N8N_WEBHOOK_AUTH_HEADER=X-FlowForge-Token
N8N_WEBHOOK_AUTH_TOKEN=
# Optional timeout for webhook calls.
N8N_CHAT_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────
# GIT PLATFORM INTEGRATION (Optional)
# For webhook handling and auto-remediation features
# ─────────────────────────────────────────────────────────────

# /api/runs has no accounts, so the server tokens below are used for live runs
# only when a request sends this key in the X-FlowForge-Operator-Key header.
# Leave unset and every visitor brings their own token (the default).
# RUNS_OPERATOR_KEY=a_long_random_string

# GitLab
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_gitlab_personal_access_token
GITLAB_PROJECT_ID=your_project_id
# Must match the "Secret token" on the GitLab webhook. Required when
# NODE_ENV=production, otherwise /api/webhooks rejects requests with 503.
GITLAB_WEBHOOK_SECRET=your_webhook_secret

# GitHub
# GITHUB_TOKEN=ghp_your_github_token
# Must match the secret on the GitHub webhook (HMAC-SHA256 over the raw body).
# Required when NODE_ENV=production.
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Bitbucket (Future)
# BITBUCKET_USERNAME=your_username
# BITBUCKET_APP_PASSWORD=your_app_password
# BITBUCKET_WORKSPACE=your_workspace
# BITBUCKET_REPO=your_repo

# ─────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────
PORT=3001

# Set to 'production' to suppress internal error details in API responses.
NODE_ENV=development

# Frontend URL for CORS (comma-separated). *.highcortisol.xyz is always allowed.
FRONTEND_URL=https://flowforge.highcortisol.xyz,https://highcortisol.xyz,https://www.highcortisol.xyz

# ─────────────────────────────────────────────────────────────
# SECURITY / ABUSE CONTROLS
# ─────────────────────────────────────────────────────────────
# Enable if running behind a reverse proxy / load balancer so rate limiting
# keys on the real client IP. Use 'true' (1 hop) or a hop count / subnet.
# TRUST_PROXY=true

# General API rate limit (per client IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Tighter limit for AI/compute routes that consume server-side provider credits.
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
